# customsubcategory=template=operations.db:tsc.subcategoryLabel.template
# customsubcategory=media=operations.db:tsc.subcategoryLabel.media
# customsubcategory=pids=operations.db:tsc.subcategoryLabel.pids
# customsubcategory=paginate=operations.db:tsc.subcategoryLabel.paginate
# customsubcategory=list=operations.db:tsc.subcategoryLabel.list

plugin.tx_operations {
  # cat=tx_operations-templating/template/030/; type=string; label=operations.db:tsc.css
  css =
  # cat=tx_operations-templating/template/045/; type=string; label=operations.db:tsc.jquery
  jquery = https://ajax.googleapis.com/ajax/libs/jquery/2.0.3/jquery.min.js

  view {
    # cat=tx_operations-templating/template/010/; type=string; label=operations.db:tsc.templateRootPath
    templateRootPath = EXT:operations/Resources/Private/Templates/
    # cat=tx_operations-templating/template/015/; type=string; label=operations.db:tsc.partialRootPath
    partialRootPath = EXT:operations/Resources/Private/Partials/
    # cat=tx_operations-templating/template/020/; type=string; label=operations.db:tsc.layoutRootPath
    layoutRootPath = EXT:operations/Resources/Private/Layouts/
  }
  persistence {
    # cat=tx_operations-storage-and-pids/pids/065; type=string; label=operations.db:tsc.storagePid
    storagePid =
    # cat=tx_operations-storage-and-pids/pids/070; type=string; label=operations.db:tsc.recursive
    recursive = 1
  }
  settings {
    # cat=tx_operations-list-settings/list/030/; type=boolean; label=operations.db:tsc.hidePagination
    hidePagination = 0
    # cat=tx_operations-list-settings/list/035/; type=boolean; label=operations.db:tsc.hideFilter
    hideFilter = 0
    # cat=tx_operations-list-settings/list/037/; type=int+; label=operations.db:tsc.lastYears
    lastYears = 5
    # cat=tx_operations-list-settings/list/040/; type=int+; label=operations.db:tsc.itemsPerPage
    itemsPerPage = 10
    # cat=tx_operations-list-settings/list/041/; type=int+; label=operations.db:tsc.limit
    limit = 200

    # cat=tx_operations-storage-and-pids/pids/300/; type=int; label=operations.db:tsc.operationSinglePid
    operationSinglePid =
    # cat=tx_operations-storage-and-pids/pids/310/; type=int; label=operations.db:tsc.vehicleSinglePid
    vehicleSinglePid =
    # cat=tx_operations-storage-and-pids/pids/320/; type=int; label=operations.db:tsc.resourceSinglePid
    resourceSinglePid =

    # cat=tx_operations-media-settings/media/200/; type=string; label=operations.db:tsc.listMediaWidth
    listMediaWidth = 250c
    # cat=tx_operations-media-settings/media/210/; type=string; label=operations.db:tsc.listMediaHeight
    listMediaHeight = 188
    # cat=tx_operations-media-settings/media/220/; type=string; label=operations.db:tsc.singleMediaWidth
    singleMediaWidth = 260c
    # cat=tx_operations-media-settings/media/230/; type=string; label=operations.db:tsc.singleMediaHeight
    singleMediaHeight = 195
    # cat=tx_operations-media-settings/media/240/; type=boolean; label=operations.db:tsc.showMediaInList
    showMediaInList = 1
    # cat=tx_operations-media-settings/media/250/; type=boolean; label=operations.db:tsc.increaseImage
    increaseImage = 1

    listMediaWidthResource = 320
    # cat=tx_operations-media-settings/media/258/; type=string; label=operations.db:tsc.listMediaHeightResource
    listMediaHeightResource =

    list {
      vehicles {
        media {
          # cat=tx_operations-media-settings/media/255/; type=string; label=operations.db:tsc.listMediaWidthVehicle
          width = 100
          # cat=tx_operations-media-settings/media/256/; type=string; label=operations.db:tsc.listMediaHeightVehicle
          height =
        }
        # cat=tx_operations-media-settings/media/257/; type=string; label=operations.db:tsc.listMediaWidthVehicle
        defaultImage {
          # cat=tx_operations-media-settings/media/265/; type=string; label=operations.db:tsc.listVehiclesDefaultImagePath
          path = EXT:operations/Resources/Public/Icons/tx_operations_vehicle.svg
          attribution =
        }
      }
      resources {
        media {
          # cat=tx_operations-media-settings/media/255/; type=string; label=operations.db:tsc.listMediaWidthResource
          width = 100
          # cat=tx_operations-media-settings/media/256/; type=string; label=operations.db:tsc.listMediaHeightResource
          height =
        }
        # cat=tx_operations-media-settings/media/257/; type=string; label=operations.db:tsc.listMediaWidthResource
        defaultImage {
          # cat=tx_operations-media-settings/media/265/; type=string; label=operations.db:tsc.listResourcesDefaultImagePath
          path = EXT:operations/Resources/Public/Icons/tx_operations_resource.svg
          attribution =
        }
      }
    }

    paginate {
      # cat=tx_operations-list-settings/paginate/310/; type=boolean; label=operations.db:tsc.insertAbove
      insertAbove = 1
      # cat=tx_operations-list-settings/paginate/320/; type=boolean; label=operations.db:tsc.insertBelow
      insertBelow = 1
      # cat=tx_operations-list-settings/paginate/320/; type=int; label=operations.db:tsc.maxNumberOfLinks
      maximumLinks = 6
    }
  }
}
