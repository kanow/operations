# typical clutter of IDEs and editors (this could be added in .git/info/exclude,
# but we add it here for convenience)
/*.idea
/.fleet
/nbproject
*.swp
*.swo
*~
*.bak
*.project
.webprj

# build, cache and test artifacts
/.Build/*
/.cache
/.php-cs-fixer.cache
/.phpunit.result.cache
/composer.build.json
/composer.lock
/node_modules/
/var

# generated documentation
/Documentation-GENERATED-temp/
*GENERATED*
